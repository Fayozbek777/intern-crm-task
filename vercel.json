{
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "devCommand": "npm start",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://for-interns.vercel.app/api/$1"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "/api",
    "CI": "false"
  }
}
